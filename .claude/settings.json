{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/allow-bash-in-cloud.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
